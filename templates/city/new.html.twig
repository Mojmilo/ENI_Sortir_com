{% extends 'base.html.twig' %}

{% block title %}Nouvelle ville{% endblock %}

{% block body %}
    <div class="flex min-h-screen items-center justify-center bg-gray-50 py-12 px-6 lg:px-8">
        <div class="w-full max-w-md space-y-8">
            <div>
                <h2 class="text-center text-3xl font-extrabold text-gray-900">Créer une ville</h2>
                <p class="mt-2 text-center text-sm text-gray-600">
                    Remplissez les champs ci-dessous pour ajouter une nouvelle ville.
                </p>
            </div>

            <div class="bg-white py-8 px-6 shadow rounded-lg">
                {{ form_start(form, { 'attr': { 'class': 'space-y-6' } }) }}
                    {{ form_row(form.name, {
                        'attr': { 'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500' }
                    }) }}
                    {{ form_row(form.postalCode, {
                        'attr': { 'class': 'block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500' }
                    }) }}
                    <div>
                        <button type="submit" class="w-full flex justify-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            Enregistrer
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>

            <div class="text-center">
                <a href="{{ path('app_city_index') }}" class="inline-flex items-center px-4 py-2 rounded-md bg-gray-300 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-300">
                    Retour à la liste
                </a>
            </div>
        </div>
    </div>
{% endblock %}
