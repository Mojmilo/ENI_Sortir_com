<!DOCTYPE html>
<html class="h-full">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <script src="../path/to/flowbite/dist/flowbite.min.js"></script>
        <link href="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.css" rel="stylesheet" />
        <script src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.js"></script>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body class="h-full">
        {% include '_header.html.twig' %}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="p-4 mb-4 text-sm rounded-lg flex items-center
                    {% if type == 'success' %}
                        text-green-700 bg-green-100 border border-green-500
                    {% elseif type == 'error' %}
                        text-red-700 bg-red-100 border border-red-500
                    {% else %}
                        text-gray-700 bg-gray-100 border border-gray-500
                    {% endif %}"
                    >
                    <svg aria-hidden="true" class="w-5 h-5 mr-2 
                        {% if type == 'success' %}text-green-700{% elseif type == 'error' %}text-red-700{% else %}text-gray-700{% endif %}" 
                        xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-9-4a1 1 0 10-2 0v3a1 1 0 001 1h1a1 1 0 100-2H9V6zm1 6a1 1 0 100 2H8a1 1 0 100 2h2a1 1 0 100-2 1 1 0 100-2h1z" clip-rule="evenodd"></path>
                    </svg>
                    <p>{{ message }}</p>
                </div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </body>
</html>
