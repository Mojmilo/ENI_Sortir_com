{% extends 'base.html.twig' %}

{% block title %}Site{% endblock %}

{% block body %}

    <div class="flex flex-col items-center justify-center min-h-screen bg-gray-50 p-6">
        <div class="w-full max-w-2xl bg-white rounded-lg shadow-lg p-6">
            <h1 class="text-3xl font-bold text-gray-800 mb-6 text-center">Détail du site </h1>

            <div class="border rounded-lg overflow-hidden">
                <table class="w-full border-collapse">
                    <tbody>
                        <tr class="bg-gray-50 border-b">
                            <th class="text-left py-3 px-4 text-sm font-medium text-gray-600 uppercase">Id</th>
                            <td class="py-3 px-4 text-gray-800">{{ site.id }}</td>
                        </tr>
                        <tr class="border-b">
                            <th class="text-left py-3 px-4 text-sm font-medium text-gray-600 uppercase">Name</th>
                            <td class="py-3 px-4 text-gray-800">{{ site.name }}</td>
                        </tr>

                    </tbody>
                </table>
            </div>

            <div class="mt-6 flex justify-between">
                <a href="{{ path('app_site_index') }}" class="inline-flex items-center px-4 py-2 bg-gray-200 text-gray-700 font-medium rounded hover:bg-gray-300">
                    Retour à la liste
                </a>
                <div class="flex space-x-4">
                    <a href="{{ path('app_site_edit', {'id': site.id}) }}" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded hover:bg-blue-700">
                        Editer
                    </a>
                    <!-- FORM DELETE -->
                    <form action="{{ path('app_site_delete', {'id': site.id}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this item?');" style="display: inline-block;">
                        <input type="hidden" name="_method" value="DELETE">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ site.id) }}">
                        <button type="submit" class="inline-flex items-center px-4 py-2 bg-red-600 text-white font-medium rounded hover:bg-red-700">
                            Supprimer
                        </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
