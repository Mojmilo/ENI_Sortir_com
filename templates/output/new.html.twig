{% extends 'base.html.twig' %}

{% block title %}New Output{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.6.0/dist/leaflet.css"
          integrity="sha512-xwE/Az9zrjBIphAcBb3F6JVqxf46+CDLwfLMHloNu6KEQCAWi6HcDUbeOfBIptF7tcCzusKFjFw2yuvEpDL9wQ=="
          crossorigin=""/>
{% endblock %}

{% block body %}
    {{ parent() }}

    {#<h1>Create new Output</h1>

    {{ include('output/_form.html.twig') }}

    <a href="{{ path('app_output_index') }}">back to list</a>#}

    <div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
        <div class="sm:mx-auto sm:w-full sm:max-w-sm">
            <h2 class="text-center text-2xl/9 font-bold tracking-tight text-gray-900">Créer une sortie</h2>
        </div>

        {{ form_start(form) }}
            <div class="space-y-6">
                <div class="mt-10 grid lg:grid-cols-2 gap-4">
                    <div>
                        <div>
                            {{ form_label(form.name, '', {
                                attr: {
                                    class: 'block text-sm/6 font-medium text-gray-900'
                                }
                            }) }}
                            <div class="mt-2">
                                {{ form_widget(form.name, {
                                    attr: {
                                        class: 'pl-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6',
                                        placeholder: 'Name'
                                    }
                                }) }}
                            </div>
                            <div class="mt-2">
                                {{ form_errors(form.name) }}
                            </div>
                        </div>
                        <div>
                            {{ form_label(form.startDatetime, '', {
                                attr: {
                                    class: 'block text-sm/6 font-medium text-gray-900'
                                }
                            }) }}
                            <div class="mt-2">
                                {{ form_widget(form.startDatetime, {
                                    attr: {
                                        class: 'pl-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6'
                                    }
                                }) }}
                            </div>
                            <div class="mt-2">
                                {{ form_errors(form.startDatetime) }}
                            </div>
                        </div>
                        <div>
                            {{ form_label(form.registrationDeadline, '', {
                                attr: {
                                    class: 'block text-sm/6 font-medium text-gray-900'
                                }
                            }) }}
                            <div class="mt-2">
                                {{ form_widget(form.registrationDeadline, {
                                    attr: {
                                        class: 'pl-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6'
                                    }
                                }) }}
                            </div>
                            <div class="mt-2">
                                {{ form_errors(form.registrationDeadline) }}
                            </div>
                        </div>
                        <div>
                            {{ form_label(form.maxNumberRegistration, '', {
                                attr: {
                                    class: 'block text-sm/6 font-medium text-gray-900'
                                }
                            }) }}
                            <div class="mt-2">
                                {{ form_widget(form.maxNumberRegistration, {
                                    attr: {
                                        class: 'pl-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6'
                                    }
                                }) }}
                            </div>
                            <div class="mt-2">
                                {{ form_errors(form.maxNumberRegistration) }}
                            </div>
                        </div>
                        <div>
                            {{ form_label(form.duration, '', {
                                attr: {
                                    class: 'block text-sm/6 font-medium text-gray-900'
                                }
                            }) }}
                            <div class="mt-2">
                                {{ form_widget(form.duration, {
                                    attr: {
                                        class: 'pl-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6'
                                    }
                                }) }}
                            </div>
                            <div class="mt-2">
                                {{ form_errors(form.duration) }}
                            </div>
                        </div>
                        <div>
                            {{ form_label(form.exitInfos, '', {
                                attr: {
                                    class: 'block text-sm/6 font-medium text-gray-900'
                                }
                            }) }}
                            <div class="mt-2">
                                {{ form_widget(form.exitInfos, {
                                    attr: {
                                        class: 'pl-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6'
                                    }
                                }) }}
                            </div>
                            <div class="mt-2">
                                {{ form_errors(form.exitInfos) }}
                            </div>
                        </div>
                    </div>
                    <div>
                        <div>
                            {{ form_label(form.site, '', {
                                attr: {
                                    class: 'block text-sm/6 font-medium text-gray-900'
                                }
                            }) }}
                            <div class="mt-2">
                                {{ form_widget(form.site, {
                                    attr: {
                                        class: 'pl-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6'
                                    }
                                }) }}
                            </div>
                            <div class="mt-2">
                                {{ form_errors(form.site) }}
                            </div>
                        </div>
                        <div class="my-4">
                            <label class="block text-sm/6 font-medium text-gray-900">Recherche</label>
                            <div class="relative">
                                <input id="search" type="text" placeholder="Recherche" class="pl-8 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6">
                                <svg class="absolute top-1/2 left-2 -translate-y-1/2 w-5 h-5 text-gray-700" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" color="#000000" fill="none">
                                    <path d="M17.5 17.5L22 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M20 11C20 6.02944 15.9706 2 11 2C6.02944 2 2 6.02944 2 11C2 15.9706 6.02944 20 11 20C15.9706 20 20 15.9706 20 11Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                                </svg>
                            </div>
                        </div>
                        <div>
                            {{ form_label(form.location.city, '', {
                                attr: {
                                    class: 'block text-sm/6 font-medium text-gray-900'
                                }
                            }) }}
                            <div class="mt-2">
                                {{ form_widget(form.location.city, {
                                    attr: {
                                        class: 'pl-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6'
                                    }
                                }) }}
                                <span id="new_city" class="hidden text-xs"></span>
                                <input id="new_city_input" name="new_city_input" hidden />
                                <input id="new_city_input_postal_code" name="new_city_input_postal_code" hidden />
                            </div>
                            <div class="mt-2">
                                {{ form_errors(form.location.city) }}
                            </div>
                        </div>
                        <div>
                            {{ form_label(form.location.name, '', {
                                attr: {
                                    class: 'block text-sm/6 font-medium text-gray-900'
                                }
                            }) }}
                            <div class="mt-2">
                                {{ form_widget(form.location.name, {
                                    attr: {
                                        class: 'pl-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6'
                                    }
                                }) }}
                            </div>
                            <div class="mt-2">
                                {{ form_errors(form.location.name) }}
                            </div>
                        </div>
                        <div>
                            {{ form_label(form.location.street, '', {
                                attr: {
                                    class: 'block text-sm/6 font-medium text-gray-900'
                                }
                            }) }}
                            <div class="mt-2">
                                {{ form_widget(form.location.street, {
                                    attr: {
                                        class: 'pl-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6'
                                    }
                                }) }}
                            </div>
                            <div class="mt-2">
                                {{ form_errors(form.location.street) }}
                            </div>
                        </div>
                        <div class="hidden">
                            {{ form_label(form.location.latitude, '', {
                                attr: {
                                    class: 'block text-sm/6 font-medium text-gray-900'
                                }
                            }) }}
                            <div class="mt-2">
                                {{ form_widget(form.location.latitude, {
                                    attr: {
                                        class: 'pl-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6'
                                    }
                                }) }}
                            </div>
                            <div class="mt-2">
                                {{ form_errors(form.location.latitude) }}
                            </div>
                        </div>
                        <div class="hidden">
                            {{ form_label(form.location.longitude, '', {
                                attr: {
                                    class: 'block text-sm/6 font-medium text-gray-900'
                                }
                            }) }}
                            <div class="mt-2">
                                {{ form_widget(form.location.longitude, {
                                    attr: {
                                        class: 'pl-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm/6'
                                    }
                                }) }}
                            </div>
                            <div class="mt-2">
                                {{ form_errors(form.location.longitude) }}
                            </div>
                        </div>
                        <div id="map" class="mt-2 h-[200px]"></div>
                    </div>
                </div>

                <div class="flex justify-center items-center gap-4">
                    <button type="submit" name="action" value="save" class="flex justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Enregistrer</button>
                    <button type="submit" name="action" value="save_and_publish" class="flex justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Publier la sortie</button>
                    <a href="{{ path('app_output_index') }}">
                        <button type="button" class="flex justify-center rounded-md bg-gray-300 px-3 py-1.5 text-sm/6 font-semibold text-gray-900 shadow-sm hover:bg-gray-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-300">Annuler</button>
                    </a>
                </div>
            </div>
        {{ form_end(form) }}
    </div>

    <script src="https://unpkg.com/leaflet@1.6.0/dist/leaflet.js"
            integrity="sha512-gZwIG9x3wUXg2hdXF6+rVkLF/0Vi9U8D2Ntg4Ga5I5BZpVkVxlJWbSQtXPSiUTtC0TjtGOmxa1AJPuV0CPthew=="
            crossorigin=""></script>
    <script type="text/javascript">
        let map;

        function init() {
            map = L.map('map').setView([51.505, -0.09], 13);
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);
        }

        window.onload = init;

        const search = document.getElementById('search');
        const locationCity = document.getElementById('output_location_city');
        const locationName = document.getElementById('output_location_name');
        const locationStreet = document.getElementById('output_location_street');
        const locationLatitude = document.getElementById('output_location_latitude');
        const locationLongitude = document.getElementById('output_location_longitude');
        const newCity = document.getElementById('new_city');
        const newCityInput = document.getElementById('new_city_input');
        const newCityInputPostalCode = document.getElementById('new_city_input_postal_code');

        // Liste des villes issues de vos données backend (à passer dynamiquement en Twig)
        const villesDisponibles = [
            {% for city in cities %}
            "{{ city.name }}"{% if not loop.last %},{% endif %}
            {% endfor %}
        ];

        search.addEventListener('input', function () {
            const value = search.value.toLowerCase();

            const urlBase = 'https://api-adresse.data.gouv.fr/search';

            fetch(`${urlBase}?q=${value}`)
                .then(response => response.json())
                .then(data => {
                    if (data.features.length > 0) {
                        // Récupérer les détails de la première correspondance
                        const feature = data.features[0];
                        const city = feature.properties.city.toLowerCase();

                        // Chercher une correspondance avec une ville disponible
                        const villeCorrespondante = villesDisponibles.find(v => v.toLowerCase() === city);

                        // Mettre à jour les champs
                        if (villeCorrespondante) {
                            Array.from(locationCity.options).forEach(option => {
                                if (option.textContent.trim().toLowerCase() === villeCorrespondante.toLowerCase()) {
                                    option.selected = true;
                                }
                            });
                            newCity.classList.add('hidden');
                            newCityInput.value = '';
                            newCityInputPostalCode.value = '';
                        } else {
                            locationCity.value = '';
                            newCity.textContent = `Nouvelle ville : ${city}`;
                            newCity.classList.remove('hidden');
                            newCityInput.value = city;
                            newCityInputPostalCode.value = feature.properties.postcode;
                        }
                        locationName.value = feature.properties.label;
                        locationStreet.value = feature.properties.name;

                        const lat = feature.geometry.coordinates[1];
                        const lng = feature.geometry.coordinates[0];
                        locationLatitude.value = lat;
                        locationLongitude.value = lng;

                        // Centrer la carte sur le lieu trouvé
                        map.flyTo([lat, lng], 15, {
                            duration: 2 // Durée en secondes pour l'animation
                        });
                    }
                });
        });
    </script>
{% endblock %}
