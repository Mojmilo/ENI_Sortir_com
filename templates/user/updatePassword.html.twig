{% extends 'base.html.twig' %}

{% block title %}Changer le mot de passe{% endblock %}

{% block body %}

    <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-center text-gray-900 dark:text-gray">Change password</h2>
    <br/>

    <div class="max-w-sm mx-auto">
        {{ form_start(changePasswordForm) }}

            {# Gestion des erreurs globales du formulaire #}
            {% if changePasswordForm.vars.errors|length > 0 %}
                <div class="mb-5 p-4 text-red-500 bg-red-100 border border-red-500 rounded-lg">
                    <p>{{ changePasswordForm.vars.errors|first.message }}</p>
                </div>
            {% endif %}

            {# Ancien mot de passe #}
            <div class="mb-5">
                {{ form_label(changePasswordForm.oldPassword) }}
                {{ form_widget(changePasswordForm.oldPassword) }}
                {{ form_errors(changePasswordForm.oldPassword) }}
            </div>

            {# Nouveau mot de passe #}
            <div class="mb-5">
                {{ form_label(changePasswordForm.newPassword.first) }}
                {{ form_widget(changePasswordForm.newPassword.first) }}
                {{ form_errors(changePasswordForm.newPassword.first) }}
            </div>

            {# Confirmation nouveau mot de passe #}
            <div class="mb-5">
                {{ form_label(changePasswordForm.newPassword.second) }}
                {{ form_widget(changePasswordForm.newPassword.second) }}
                {{ form_errors(changePasswordForm.newPassword.second) }}
            </div>

            <div class="mt-6 flex items-center justify-center gap-x-6">
                <button type="submit" class="flex justify-center rounded-md bg-gray-300 px-3 py-1.5 text-sm/6 font-semibold text-gray-900 shadow-sm hover:bg-gray-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-300">
                Modifier</button>      
            </div>

        {{ form_end(changePasswordForm) }}
    </div>
{% endblock %}
