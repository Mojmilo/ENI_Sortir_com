{% extends 'base.html.twig' %}

{% block title %}Utilisateurs par CSV{% endblock %}

{% block body %}

    <h2 class="text-center text-2xl/9 font-bold tracking-tight text-gray-900">Importer des utilisateurs depuis un fichier CSV</h2>
    
    {{ form_start(form) }}
        {{ form_row(form.csvFile) }}
        <button class="btn">Importer</button>
    {{ form_end(form) }}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

{% endblock %}
